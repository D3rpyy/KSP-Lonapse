<Project Sdk="Microsoft.NET.Sdk">
  <!-- Only for editor support (OmniSharp in Codium). The real build is build.sh with mcs. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Lonapse</AssemblyName>
    <RootNamespace>Lonapse</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- the KSP install comes from $KSP_DIR or the first line of .ksp_dir, same as build.sh -->
    <KspDir Condition="'$(KSP_DIR)' != ''">$(KSP_DIR)</KspDir>
    <KspDir Condition="'$(KspDir)' == '' And Exists('$(MSBuildThisFileDirectory).ksp_dir')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory).ksp_dir').Trim().Split('%0A')[0].Trim())</KspDir>
    <Managed>$(KspDir)/KSP_Data/Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>False</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="$(Managed)/Assembly-CSharp.dll" />
    <Reference Include="$(Managed)/Assembly-CSharp-firstpass.dll" />
    <Reference Include="$(Managed)/UnityEngine.dll" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.AudioModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.InputLegacyModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.PhysicsModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.AnimationModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.TextRenderingModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.UIModule.dll" />
    <Reference Include="$(Managed)/UnityEngine.UI.dll" />
  </ItemGroup>
</Project>
